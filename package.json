    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.108.2",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.2.0",
    "jsonwebtoken": "9.0.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
